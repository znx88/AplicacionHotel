<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="650.0" prefWidth="674.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="HotelController">

   <children>
      <Label text="HOTEL SOL - RESERVAS">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <Label fx:id="lblInfo" text="Cargando datos..." wrapText="true" />

      <ListView fx:id="listaHabitaciones" prefHeight="410.0" prefWidth="600.0" />

      <Label text="Buscar habitación por número:" />

      <TextField fx:id="txtNumero" prefHeight="25.0" prefWidth="67.0" promptText="Ej: 205" />

      <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscar" text="BUSCAR" />

      <Label fx:id="lblResultado" text="Introduce un número y pulsa Buscar." wrapText="true">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>

      <!-- Ingresos según fecha -->
      <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;" text="Ingresos según fecha" />

      <HBox alignment="CENTER_LEFT" spacing="15">
         <children>
            <Label text="Desde:" />
            <DatePicker fx:id="dateDesde" promptText="dd/MM/yyyy" />
            <Label text="Hasta:" />
            <DatePicker fx:id="dateHasta" promptText="dd/MM/yyyy" />
            <Button fx:id="btnIngresosFecha" onAction="#calcularIngresosFecha" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 20; -fx-cursor: hand;" text="Calcular Ingresos" />
         </children>
      </HBox>

      <TableView fx:id="tablaIngresosFecha" prefWidth="500.0">
         <columns>
            <TableColumn prefWidth="150.0" text="Fecha">
               <cellValueFactory><PropertyValueFactory property="fecha" /></cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="100.0" text="Reservas">
               <cellValueFactory><PropertyValueFactory property="cantidad" /></cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="150.0" text="Ingresos (€)">
               <cellValueFactory><PropertyValueFactory property="ingresos" /></cellValueFactory>
            </TableColumn>
         </columns>
      </TableView>
   </children>
</VBox>
